# Solana reads (mainnet) — any RPC; Helius/Shyft keys raise rate limits
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# A Helius URL (https://mainnet.helius-rpc.com/?api-key=…) also switches on the Money Flow trace (Enhanced Transactions API); any other RPC skips it
# Concordium testnet node (gRPC v2)
CONCORDIUM_NODE=grpc.testnet.concordium.com:20000
# Anthropic key for the agent swarm
ANTHROPIC_API_KEY=
# Swarm models and effort (defaults shown): specialists on Haiku, judge on Opus
SENTINEL_SPECIALIST_MODEL=claude-haiku-5-5
SENTINEL_JUDGE_MODEL=claude-opus-5-5
SENTINEL_SPECIALIST_EFFORT=low
SENTINEL_JUDGE_EFFORT=medium   # raise to high for the demo recording

# Verdict track: the resolver re-reads every judged token at fixed horizons, grades the outcome (TVL rug, idle,
# price collapse) and records the grade on the audit contract beside the sealed verdict. GET /track scores the history.
SENTINEL_RESOLVER=1                      # 0 turns grading off
SENTINEL_RESOLVE_EVERY_S=300             # how often the resolver looks for due verdicts
SENTINEL_RESOLVE_HORIZONS=3600,86400,604800   # seconds after the verdict: 1h, 24h, 7d
SENTINEL_ADVOCATE=1            # 0 skips the advocate stage
SENTINEL_COUNCIL=1             # 0 skips the council (anonymous peer ranking of findings)

# Concordium (testnet). Wallet export files live in concordium/keys/ (gitignored)
CONCORDIUM_NETWORK=testnet
CONCORDIUM_OWNER_WALLET=concordium/keys/owner.export        # owns the agent NFTs, deploys the audit contract
CONCORDIUM_SUBMITTER_WALLET=concordium/keys/submitter.export # the judge: allowed to call sentinel_audit.record
CONCORDIUM_SPONSOR_WALLET=concordium/keys/sponsor.export    # x402 facilitator: pays fees for paying agents
CONCORDIUM_PAYER_WALLET=concordium/keys/payer.export        # demo client that buys a verdict
CONCORDIUM_PAY_TO=                                           # account that receives x402 payments (defaults to owner)
SENTINEL_BASE_URL=https://api.santinelguard.online          # public origin where Agent Cards are served byte-exact (see docs/DEPLOY.md)
SENTINEL_GATEWAY_PORT=4020
X402_FACILITATOR_PORT=4021
X402_FACILITATOR_URL=                                        # leave empty to run the facilitator in-process
X402_PRICE_MICROCCD=1000000                                  # 1 CCD per verdict

# Showcase site
SENTINEL_CORS_ORIGINS=http://localhost:3000,http://localhost:3100   # origins allowed to stream from the API directly
NEXT_PUBLIC_SENTINEL_API_URL=http://localhost:4020                  # the site's direct API origin (SSE); JSON goes through the Next proxy
SENTINEL_PQ_SEED=                                                    # 32-byte hex seed for the ML-DSA-65 verdict signature key

# Solana real-time stream (Shyft Yellowstone gRPC): new mints and swaps for the live feed and faster pool reads
SHYFT_GRPC_URL=https://grpc.eu.shyft.to
SHYFT_GRPC_TOKEN=
